SECRET_KEY=generate-a-strong-secret-key
DEBUG=False
ALLOWED_HOSTS=your-backend-service.onrender.com
BACKEND_PUBLIC_URL=https://your-backend-service.onrender.com
FRONTEND_URL=https://your-frontend-site.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-site.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-backend-service.onrender.com,https://your-frontend-site.onrender.com
CORS_ALLOW_CREDENTIALS=True
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://host:6379
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=FocusFlow <your-email@example.com>
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
